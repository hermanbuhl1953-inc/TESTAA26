generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HouseholdMemberRole {
  ADULT
  CHILD
}

enum HousingType {
  RENT
  OWNED
  OTHER
}

enum EmploymentStatus {
  EMPLOYED
  UNEMPLOYED
  INACTIVE
}

enum BenefitRuleField {
  region
  municipality
  iseeAmountCents
  iseeType
  adultCount
  childCount
  householdSize
  childAges
  hasMinor
  hasChildUnder3
  hasAdultOver65
  hasDisability
  hasNonSelfSufficientMember
  employmentStatuses
  housingType
  registeredRentalContract
  residenceMonths
}

enum BenefitRuleOperator {
  EQ
  NE
  LTE
  GTE
  IN
  BETWEEN
  ANY_BETWEEN
  ALL_BETWEEN
  CONTAINS
}

enum AuthorityType {
  REGION
  MUNICIPALITY
  NATIONAL
  OTHER
}

enum MeasureBenefitType {
  BONUS
  CONTRIBUTION
  DISCOUNT
  REIMBURSEMENT
  SERVICE
  TAX_RELIEF
  OTHER
}

enum MeasureStatus {
  OPEN
  UPCOMING
  CLOSED
  UNKNOWN
}

enum MeasureDataQuality {
  VERIFIED
  PARTIAL
  TO_VERIFY
}

enum MeasureRecordType {
  DEMO
  SAMPLE
  REAL
}

enum CandidateReviewStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVIEW
}

model Benefit {
  id          String        @id @default(cuid())
  code        String        @unique
  title       String
  description String
  opensAt     DateTime?
  closesAt    DateTime?
  rules       BenefitRule[]
  authorityType AuthorityType?
  authorityName String?
  territory    Json?
  category     String?
  benefitType  MeasureBenefitType?
  amount       Json?
  requirements Json?
  application  Json?
  source       Json?
  measureStatus MeasureStatus?
  dataQuality  MeasureDataQuality?
  recordType   MeasureRecordType?
  unstructuredRequirements String[] @default([])
  provenance   Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model CandidateMeasure {
  id              String               @id @default(cuid())
  sourceId        String
  fingerprint     String
  contentHash     String
  normalizedMeasure Json
  validationResult  Json
  sourceInformation Json
  ingestedAt      DateTime             @default(now())
  warnings        String[]             @default([])
  conflicts       Json
  reviewStatus    CandidateReviewStatus @default(PENDING)
  createdAt       DateTime             @default(now())

  @@index([sourceId, ingestedAt])
  @@index([fingerprint])
  @@index([contentHash])
}

model BenefitRule {
  id            String   @id @default(cuid())
  benefitId     String
  code          String
  label         String
  field         BenefitRuleField
  operator      BenefitRuleOperator
  expectedValue Json
  required      Boolean  @default(true)
  benefit       Benefit  @relation(fields: [benefitId], references: [id], onDelete: Cascade)

  @@unique([benefitId, code])
  @@index([benefitId])
}

model HouseholdProfile {
  id                         String            @id @default(cuid())
  region                     String?
  municipality               String?
  iseeAmountCents            Int?
  iseeType                   String?
  adultCount                 Int?
  childCount                 Int?
  housingType                HousingType?
  registeredRentalContract   Boolean?
  residenceMonths            Int?
  members                    HouseholdMember[]
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
}

model HouseholdMember {
  id                    String               @id @default(cuid())
  householdProfileId    String
  role                  HouseholdMemberRole
  ageYears              Int?
  hasDisability         Boolean?
  isNonSelfSufficient   Boolean?
  employmentStatus      EmploymentStatus?
  householdProfile      HouseholdProfile     @relation(fields: [householdProfileId], references: [id], onDelete: Cascade)

  @@index([householdProfileId])
}
